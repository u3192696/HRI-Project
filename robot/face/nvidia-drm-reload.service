[Unit]
Description=Reload nvidia_drm once so EGL initialises (Jetson Orin kiosk workaround)
Documentation=file:///home/jetson/robot/face/README.md
# Deliberately NOT anchored to sysinit.target. An earlier draft used
# DefaultDependencies=no + Before=sysinit.target, which conflicts with the
# After=systemd-udev-settle.service below and would create an ordering cycle
# that systemd resolves by dropping dependencies - i.e. silent, unpredictable
# behaviour. Keeping this an ordinary boot service ordered ahead of the kiosk is
# simpler and does exactly what is needed.
#
# Ordering, not requirement: face-kiosk declares Wants= on this unit, and this
# declares Before=face-kiosk, so the compositor never starts first.
Before=face-kiosk.service
# The modules-load.d list performs the first (too early) load of nvidia_drm,
# which is the thing being corrected. Do not run before it has finished.
After=systemd-modules-load.service
Requires=systemd-modules-load.service
# tegra_drm is probed off the platform/udev path; the reload is only useful once
# the Tegra DRM stack it must follow is present. The script also waits for it.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nvidia-drm-reload.sh
# Loading/unloading kernel modules requires root.
User=root
# The script's own waits are bounded well inside this, so this is a backstop
# against a wedged module rather than the normal path.
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
