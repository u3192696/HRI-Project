[Unit]
Description=Voice listener — hears "system command <verb>", confirms with a pass phrase, logs it
Documentation=file:/home/jetson/robot/voice/README.md

# Listens on the USB microphone and appends each trigger, prompt, confirmation and
# timeout to /tmp/voice-detection.log. Nothing here touches the network or the
# camera.
#
# WHAT A CONFIRMED COMMAND DOES: it is PUBLISHED, not executed. "system command
# start" writes /run/face/command.json and the session conductor acts on it; the
# participant's stage word is published the same way, as `begin`. The EXECUTORS
# table in listener.py is still empty for every other verb, so a confirmed
# `shutdown` or `reboot` logs "WOULD EXECUTE" and stops there. That one goes last on
# purpose: it is the verb that powers off the board this unit runs on.
#
# Deliberately NOT ordered against greeter.service, gaze.service or
# face-kiosk.service. It reads a FILE and opens a microphone, so it degrades on
# its own: with the greeter down it simply listens to a quiet room. Coupling them
# would only let one unrelated failure take the other down.
#
# THE ONE REAL COUPLING is the face directory, and it is not obvious: the
# half-duplex gate works by checking whether /run/face/mouth.json has been written
# recently. If /run/face does not exist then that file never appears, the gate
# concludes "the robot is not speaking", and the listener happily transcribes the
# robot's own voice. So this unit needs the directory to exist even though it
# never writes to it.
#
# /run/face is created by /etc/tmpfiles.d/robot-face.conf (systemd-tmpfiles), NOT
# by RuntimeDirectory: two units declaring one path means systemd deletes the
# directory when EITHER stops, and `jetson` cannot recreate it under root-owned
# /run.
After=systemd-tmpfiles-setup.service
Wants=systemd-tmpfiles-setup.service

# Audio needs the user's runtime dir. Audio here is PipeWire running in jetson's
# session, with its socket at /run/user/1000/pulse/native. At a cold boot nothing
# has logged in, so logind has not created /run/user/1000 yet; this unit is what
# makes it appear. Same dependency the greeter documents, and the same reason it
# is needed even though lingering is enabled.
After=user-runtime-dir@1000.service
Wants=user-runtime-dir@1000.service

# StartLimit* belong in [Unit]; systemd SILENTLY IGNORES them in [Service]
# ("Unknown key name ... ignoring"). Interval 0 disables rate limiting: this is a
# bench prototype, so a permanent fault should keep retrying rather than leave an
# unattended robot silently unable to hear anyone.
StartLimitIntervalSec=0

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/robot/voice

# A system service gets no XDG_RUNTIME_DIR from logind, and without it arecord
# cannot find the PipeWire socket at all: it fails looking like "no audio
# hardware" rather than "no session".
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Without this, stdout sits in Python's block buffer and `journalctl -f` shows
# nothing until the buffer fills, which reads as a listener that is not working.
Environment=PYTHONUNBUFFERED=1

# The venv is NOT deployed by robot/deploy.sh (it excludes .venv/), so it is
# device-local state. It carries vosk; the system python3 does not have it. The
# model is device-local too, 68 MB, fetched by fetch-model.sh. The installer
# pre-flight checks both, because a missing either one produces a service that
# starts perfectly and hears nothing.
ExecStart=/home/jetson/robot/voice/.venv/bin/python \
    /home/jetson/robot/voice/listener.py

# SIGTERM is handled in listener.py rather than left to the default, because the
# default kills Python without running the cleanup that terminates arecord, which
# would leave a recorder behind still holding the capture source. TimeoutStopSec
# is generous so the 125 ms loop always gets a tick to notice.
KillSignal=SIGTERM
TimeoutStopSec=10

# Retries a mic that is not there yet, which is a real cold-boot case: the USB
# dongle enumerates after the session does.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
